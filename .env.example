# Copy this file to .env and fill in the values. Never commit .env.
# Used from the testnet deployment phase on; local tests do not need them.

# Private key of the backend wallet that deploys and owns DeliveryRegistry.
PRIVATE_KEY=
# RPC URL of the testnet (Alchemy or Infura).
RPC_URL=
# API key of the block explorer, to verify the contract.
ETHERSCAN_API_KEY=
