# Copy this file to .env and fill in the values. Never commit .env.
# Used to deploy on Sepolia; local tests do not need them.

# Private key of the backend wallet that deploys and owns DeliveryRegistry.
# Use a test wallet with Sepolia ETH from a faucet, never a wallet with real funds.
PRIVATE_KEY=
# Sepolia RPC URL (Alchemy or Infura), e.g. https://eth-sepolia.g.alchemy.com/v2/<key>
RPC_URL=
# Etherscan API key, to verify the contract.
ETHERSCAN_API_KEY=
